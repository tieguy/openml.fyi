---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogType?: string;
  ogImage?: string;
  publishedTime?: string;
}

const { title, description, ogType = 'website', ogImage, publishedTime } = Astro.props;

const SITE_NAME = 'Open+ML';
const TAGLINE = '(ir)regular updates from the jagged frontier of ML and open';
const finalTitle = title === SITE_NAME ? SITE_NAME : `${title} — ${SITE_NAME}`;
const resolve = (path: string) => new URL(path, Astro.site ?? Astro.url).href;
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{finalTitle}</title>
  <meta name="description" content={description ?? TAGLINE} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description ?? TAGLINE} />
  {ogImage && <meta property="og:image" content={resolve(ogImage)} />}
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={Astro.url.href} />
  <meta property="og:site_name" content={SITE_NAME} />
  {publishedTime && <meta property="article:published_time" content={publishedTime} />}
  <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/rss/" />
  <link rel="me" href="https://social.coop/@luis_in_brief" />
</head>
<body>
  <header class="site-header">
    <a class="site-title" href="/">{SITE_NAME}</a>
    <nav>
      <a href="/archive/">Archive</a>
      <a href="/tags/">Tags</a>
      <a href="/about/">About</a>
      <a href="https://lu.is">lu.is</a>
    </nav>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <p>
      <strong>{SITE_NAME}</strong> ran from September 2022 to April 2026. It has
      concluded, so that I can focus more on learning by doing. You can follow
      that at <a href="https://lu.is">lu.is</a>.
    </p>
  </footer>
</body>
</html>
