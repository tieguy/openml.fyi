---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTagCounts } from '../../lib/entries';

const tags = await getTagCounts();
---

<BaseLayout title="Tags" description="Browse the Open+ML archive by subject.">
  <h1>Tags</h1>
  <p class="lede">
    The newsletter itself carried no tags; these were assigned when the archive
    was built, by what each issue is substantially about rather than everything
    it mentions.
  </p>
  <ul class="tag-cloud">
    {tags.map(({ tag, count }) => (
      <li>
        <a href={`/tags/${tag}/`}>{tag}</a> <span class="count">{count}</span>
      </li>
    ))}
  </ul>
</BaseLayout>
